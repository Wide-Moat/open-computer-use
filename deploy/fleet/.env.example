# Fleet bring-up environment. Copy to `.env` (gitignored) and set real values.
# The two embed/session secrets are fail-closed: compose refuses to start
# without them (no default), because a default-keyed deployment would verify
# any forged embed token. Generate each with `openssl rand -hex 32`.

# Web UI BFF — required, >=32 bytes each. No default by design.
OCU_EMBED_VERIFY_SECRET=
OCU_SESSION_SECRET=

# Web UI BFF — optional, shown with their compose defaults.
OCU_EMBED_AUDIENCE=ocu-webui

# Control's Docker-socket group. Control (uid 65532) joins this gid to read the
# socket for the per-session container lifecycle. Default 0 fits Docker Desktop
# (socket is root:root). On a native Linux/Lima dockerd the socket is owned by a
# distinct `docker` gid — set it here:
#   OCU_DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)
OCU_DOCKER_GID=0

# Object-store + MinIO — optional, shown with their compose defaults.
OCU_S3_ACCESS_KEY_ID=ocu-fleet-root
OCU_S3_SECRET_ACCESS_KEY=ocu-fleet-secret-key
OCU_S3_BUCKET=ocu-fleet
OCU_FILESYSTEM_ID=fs-fleet

# Guest image for the sandbox. The demo file tools (create_file/view/str_replace)
# need python3 in the guest; the stripped default lacks it. Override to a
# python3-bearing FAT guest for a full file-tool run (see task #122):
#   OCU_GUEST_IMAGE=ocu-guest:poc-fat-arm64
# The stripped default runs bash-only tools fine.
OCU_GUEST_IMAGE=ocu-guest:assembled
OCU_GUEST_IMAGE_ALLOW=ocu-guest:assembled-demo

# Download exfil control: which stored-object prefixes are byte-downloadable.
# /outputs = deliverables only (NFR-SEC-73); bare / is a matches-nothing sentinel,
# * reopens the exfil hole. Do not widen without the storage-scope review.
OCU_DOWNLOADABLE_PREFIXES=/outputs
